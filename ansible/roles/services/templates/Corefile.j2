# Lab DNS (CoreDNS). Rendered by Ansible.
# Authoritative for {{ dns.zone }} from a real zone file (SOA/NS/A records), so
# unknown names get a proper NXDOMAIN. Everything else is forwarded upstream.
{{ dns.zone }}:53 {
    file /etc/coredns/{{ dns.zone }}.zone {
        reload 10s
    }
    log
    errors
}
.:53 {
    forward . 127.0.0.11      # Docker's resolver -> the VM's DNS -> internet
    cache 60
    errors
}
