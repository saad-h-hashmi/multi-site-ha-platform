; {{ dns.zone }} zone. Rendered by Ansible from group_vars/all.yml; do not edit.
$ORIGIN {{ dns.zone }}.
$TTL 60
@       IN SOA  dns.{{ dns.zone }}. hostmaster.{{ dns.zone }}. ( {{ zone_serial }} 3600 600 86400 60 )
@       IN NS   dns.{{ dns.zone }}.

; ---- Shared services (WAN segment) ----
dns         IN A {{ dns.ip }}
registry    IN A {{ registry.ip }}
edge        IN A {{ edge.ip }}
api         IN A {{ edge.ip }}
{{ app.hostname | replace('.' ~ dns.zone, '') }}   IN A {{ edge.ip }}
prometheus  IN A {{ edge.ip }}
{% for s in sites %}

; ---- {{ s.description }} ----
router-{{ s.id }}        IN A {{ s.router_wan_ip }}
gw.{{ s.name }}       IN A {{ s.router_lan_ip }}
{{ s.name }}-server   IN A {{ s.server_ip }}
{{ s.name }}-agent    IN A {{ s.agent_ip }}
{% endfor %}
