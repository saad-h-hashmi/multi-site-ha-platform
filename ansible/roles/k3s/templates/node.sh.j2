#!/bin/sh
# Start-up wrapper for K3s node {{ node.name }} ({{ node.site.description }}).
# Rendered by Ansible. Points the node at its site router and lab DNS, then
# hands over to K3s (exec keeps K3s as PID 1, which K3s needs for cgroups).
set -e
# All off-site traffic leaves through this site's router.
ip route replace default via {{ node.site.router_lan_ip }}
printf 'nameserver {{ dns.ip }}\nsearch {{ dns.zone }}\n' > /etc/resolv.conf
exec /bin/k3s "$@" --config /lab/config.yaml   # "$@" = server | agent
