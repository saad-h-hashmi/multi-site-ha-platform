    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Node memory (working set)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (container_memory_working_set_bytes{id=\"/\"})",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Node CPU (cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 19,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (node) (rate(container_cpu_usage_seconds_total{id=\"/\"}[2m]))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
