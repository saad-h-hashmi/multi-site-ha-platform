    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(etcd_server_leader_changes_seen_total[1h])",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
